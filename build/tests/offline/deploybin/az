#!/usr/bin/env bash
# Fake az for tests/offline/Deploy.Scenario.ps1: logs each call to $FAKE_AZ_LOG and answers the
# calls scripts/deploy/deploy.sh makes. State comes from the environment:
#   FAKE_HOSTS_RG_EXISTS  true|false   whether rg-<prefix>-<env>-hosts exists (false = first deployment)
#   FAKE_NOT_RUNNING      VM resource IDs whose power state isn't 'VM running', one per line
#   FAKE_POWER_LOCK       the host pool's avdlz-power-lock tag (empty = not locked)
#   FAKE_POOL_TAGS        the host pool's rotation tags as az prints them (JSON; empty = no host pool)
#   FAKE_POOL_READ_ERROR  set: reading the host pool fails with this error (not a missing pool)
#   FAKE_AZ_SUB           the subscription ID az has selected (default: the mock's)
#   FAKE_AZ_SET_FAIL      set: 'az account set' fails
#   FAKE_SUB_MISSING      set: 'az account show --subscription' fails (deploy.sh -s names no subscription)
#   FAKE_SUB_TENANT       tenant of the subscription named by --subscription (default: the signed-in one)
#   FAKE_DEPLOY_EXIT      exit code of 'az deployment sub create'
#   FAKE_GROUP_OWNERS     owner object IDs of a group found by name, one per line (empty = no owners)
#   FAKE_ADMIN_IDS        members of the Global Administrator role, one per line
echo "az $*" >> "$FAKE_AZ_LOG"
case "$1 $2" in
  "bicep version"|"provider register"|"feature register") exit 0 ;;
  "account show")
    if [[ "$*" == *--subscription* ]]; then
      [[ -n "${FAKE_SUB_MISSING:-}" ]] && { echo "ERROR: Subscription '${*##*--subscription }' not found." >&2; exit 1; }
      case "$*" in
        *"--query name"*) echo "Fake other subscription" ;;
        *"--query id"*) echo 00000000-aaaa-bbbb-cccc-000000000002 ;;
        *"--query tenantId"*) echo "${FAKE_SUB_TENANT:-00000000-0000-0000-0000-0000000000f1}" ;;
        *) echo '{}' ;;
      esac
    else
      case "$*" in
        *"--query name"*) echo "Fake subscription" ;;
        *"--query id"*) echo "${FAKE_AZ_SUB:-00000000-aaaa-bbbb-cccc-000000000001}" ;;
        *"--query tenantId"*) echo 00000000-0000-0000-0000-0000000000f1 ;;
        *) echo '{}' ;;
      esac
    fi ;;
  "account set") [[ -n "${FAKE_AZ_SET_FAIL:-}" ]] && { echo "ERROR: The subscription could not be found." >&2; exit 1; } ;;
  "provider show"|"feature show") echo Registered ;;
  "ad group") case "$3" in
      owner) [[ -n "${FAKE_GROUP_OWNERS:-}" ]] && printf '%s\n' "$FAKE_GROUP_OWNERS" ;;
      *) echo 00000000-0000-0000-0000-0000000000a1 ;;
    esac ;;
  "ad signed-in-user") echo 00000000-0000-0000-0000-0000000000a9 ;;
  "ad sp") echo 00000000-0000-0000-0000-0000000000a2 ;;
  "rest --method") case "$*" in
      *"directoryRoles?"*62e90394*) echo role-ga ;;
      *directoryRoles/role-ga/members*) [[ -n "${FAKE_ADMIN_IDS:-}" ]] && printf '%s\n' "$FAKE_ADMIN_IDS" ;;
      *) : ;;
    esac ;;
  "group exists") [[ "$*" == *-jumpbox* ]] && echo "${FAKE_JUMPBOX_RG_EXISTS:-false}" || echo "${FAKE_HOSTS_RG_EXISTS:-false}" ;;
  "vm show") [[ -n "${FAKE_JUMPBOX_VM_ERROR:-}" ]] && { echo "ERROR: $FAKE_JUMPBOX_VM_ERROR" >&2; exit 1; }
    # As Azure answers: no resource group is ResourceGroupNotFound, no VM in it is ResourceNotFound (lesson 0034).
    if [[ "${FAKE_JUMPBOX_VM_EXISTS:-}" == true ]]; then echo "${FAKE_JUMPBOX_OS:-Linux}"
    elif [[ "${FAKE_JUMPBOX_RG_EXISTS:-}" == true ]]; then echo "ERROR: (ResourceNotFound) The Resource 'Microsoft.Compute/virtualMachines/vm-avdlz-dev-jumpbox' under resource group 'rg-avdlz-dev-jumpbox' was not found." >&2; exit 3
    else echo "ERROR: (ResourceGroupNotFound) Resource group 'rg-avdlz-dev-jumpbox' could not be found." >&2; exit 3; fi ;;
  "resource show") case "$*" in
      *avdlz-power-lock*) [[ -n "${FAKE_POWER_LOCK:-}" ]] && printf '%s\n' "$FAKE_POWER_LOCK" ;;
      *avdlz-rotation*)
        [[ -n "${FAKE_POOL_READ_ERROR:-}" ]] && { echo "ERROR: $FAKE_POOL_READ_ERROR" >&2; exit 1; }
        # Azure CLI fails on a missing resource (exit 3), it doesn't print nothing.
        [[ -z "${FAKE_POOL_TAGS:-}" ]] && { echo "ERROR: (ResourceNotFound) The Resource 'Microsoft.DesktopVirtualization/hostPools/vdpool-avdlz-dev' was not found." >&2; exit 3; }
        printf '%s\n' "$FAKE_POOL_TAGS" ;;
    esac ;;
  "vm list") [[ -n "${FAKE_NOT_RUNNING:-}" ]] && printf '%s\n' "$FAKE_NOT_RUNNING" ;;
  "vm start"|"vm deallocate") exit 0 ;;
  "deployment sub")
    case "$3" in
      what-if) echo "runbook-env ${AVD_RUNBOOK_URI:-}" >> "$FAKE_AZ_LOG"; echo "(what-if output)" ;;
      create) echo "deploy-env image=${AVD_SESSION_HOST_IMAGE_ID:-} gen=${AVD_SESSION_HOST_GENERATION:-} tags=${AVD_HOST_POOL_STATE_TAGS:-}" >> "$FAKE_AZ_LOG"
        echo "runbook-env ${AVD_RUNBOOK_URI:-}" >> "$FAKE_AZ_LOG"
        echo "jumpbox-env deploy=${AVD_DEPLOY_JUMPBOX:-} exists=${AVD_JUMPBOX_EXISTS:-} until=${AVD_JUMPBOX_KEEP_RUNNING_UNTIL:-} os=${AVD_JUMPBOX_OS:-}" >> "$FAKE_AZ_LOG"
        echo '{}'; exit "${FAKE_DEPLOY_EXIT:-0}" ;;
      show) [[ "$*" == *controlPlane* ]] && echo rg-avdlz-dev-avd || echo stavdlzdevfake ;;
    esac ;;
  *) echo "fake az: unmocked call: az $*" >&2; exit 2 ;;
esac
exit 0
