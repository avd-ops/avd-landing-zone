# Line endings stay LF in the repo whatever the clone's core.autocrlf (avd-ops docs/run-anywhere.md):
# Bash fails on a CRLF script, and the fake az and gh in build/tests/offline have no extension.
* text=auto
*.sh text eol=lf
.githooks/* text eol=lf
build/tests/offline/bin/* text eol=lf
build/tests/offline/deploybin/* text eol=lf

# Vendored contract files are hashed byte for byte (contracts/PINS.json).
contracts/schemas/*.json -text
contracts/examples/*.json -text
contracts/fact-register.json -text
contracts/run-use-cases.json -text
# Release and tag archives (the "Source code" zip on each GitHub release) carry only what a
# person needs to deploy and run the landing zone: see releases/README.md.
/build export-ignore
/site export-ignore
/.claude export-ignore
/.githooks export-ignore
/.github export-ignore
/PSScriptAnalyzerSettings.psd1 export-ignore
/.gitleaksignore export-ignore
/CLAUDE.md export-ignore
/AGENTS.md export-ignore
/scripts/kb export-ignore
/docs/accepted-findings.json export-ignore
