#!/usr/bin/env bash
# Fake az for tests/offline/Deploy.Scenario.ps1: logs each call to $FAKE_AZ_LOG and answers the
# calls scripts/deploy/deploy.sh makes. State comes from the environment:
#   FAKE_HOSTS_RG_EXISTS  true|false   whether rg-<prefix>-<env>-hosts exists (false = first deployment)
#   FAKE_NOT_RUNNING      VM resource IDs whose power state isn't 'VM running', one per line
#   FAKE_POWER_LOCK       the host pool's avdlz-power-lock tag (empty = not locked)
#   FAKE_DEPLOY_EXIT      exit code of 'az deployment sub create'
echo "az $*" >> "$FAKE_AZ_LOG"
case "$1 $2" in
  "bicep version"|"provider register"|"feature register") exit 0 ;;
  "account show") [[ "$*" == *"--query name"* ]] && echo "Fake subscription" || echo '{}' ;;
  "provider show"|"feature show") echo Registered ;;
  "ad group") echo 00000000-0000-0000-0000-0000000000a1 ;;
  "ad sp") echo 00000000-0000-0000-0000-0000000000a2 ;;
  "group exists") echo "${FAKE_HOSTS_RG_EXISTS:-false}" ;;
  "resource show") [[ -n "${FAKE_POWER_LOCK:-}" ]] && printf '%s\n' "$FAKE_POWER_LOCK" ;;
  "vm list") [[ -n "${FAKE_NOT_RUNNING:-}" ]] && printf '%s\n' "$FAKE_NOT_RUNNING" ;;
  "vm start"|"vm deallocate") exit 0 ;;
  "deployment sub")
    case "$3" in
      what-if) echo "(what-if output)" ;;
      create) echo '{}'; exit "${FAKE_DEPLOY_EXIT:-0}" ;;
      show) [[ "$*" == *controlPlane* ]] && echo rg-avdlz-dev-avd || echo stavdlzdevfake ;;
    esac ;;
  *) echo "fake az: unmocked call: az $*" >&2; exit 2 ;;
esac
exit 0
