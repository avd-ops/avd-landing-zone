{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avd-ops.dev/contracts/power-platform-manifest.schema.json",
  "title": "avd-power-platform handoff manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "environment",
    "powerPlatformEnvironmentName",
    "dlpPolicyName",
    "activeWorkflows"
  ],
  "properties": {
    "schema": {
      "const": "avd-ops-power-platform-manifest/v1"
    },
    "environment": {
      "type": "string",
      "enum": [
        "dev",
        "test",
        "prod"
      ]
    },
    "cloud": {
      "type": "string",
      "enum": [
        "commercial",
        "usgov"
      ]
    },
    "powerPlatformEnvironmentName": {
      "type": "string"
    },
    "dlpPolicyName": {
      "type": "string"
    },
    "enterprisePolicyStatus": {
      "type": "string",
      "enum": [
        "deployed",
        "not-configured",
        "skipped: unsupported-in-usgov"
      ]
    },
    "vnetInjectionStatus": {
      "type": "string",
      "enum": [
        "deployed",
        "not-configured",
        "skipped: unsupported-in-usgov"
      ]
    },
    "enterprisePolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "deployed",
            "not-configured",
            "skipped",
            "skipped: unsupported-in-usgov"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "activeWorkflows": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
