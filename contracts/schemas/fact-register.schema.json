{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "avd-fact-register/v1: every fact a repo may cite, and the design decisions they evidence",
  "description": "Contract C15. The one list of fact IDs used by the target-state manifest (C14), avd-swarm's gate and the brain's agents. Each fact names its tier, the contract and JSON path it comes from, its grain, unit and privacy class, and the C14 decisions it can evidence. Tests in tests/Connectors.Tests.ps1 resolve every built fact's path in its contract's schema.",
  "type": "object",
  "required": [
    "schema",
    "version",
    "decisions",
    "facts"
  ],
  "additionalProperties": false,
  "$defs": {
    "tier": {
      "enum": [
        "azure",
        "forensic",
        "intake",
        "liquidware"
      ]
    },
    "decisionId": {
      "type": "string",
      "pattern": "^[a-z][A-Za-z.]{1,40}$"
    }
  },
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema": {
      "const": "avd-fact-register/v1"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Bumped on any change that removes or renames a fact; manifests pin it (C14 pins.factRegister)"
    },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "manifestPath",
          "label",
          "decidableFrom"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/decisionId"
          },
          "manifestPath": {
            "type": "string",
            "pattern": "^(/[A-Za-z*]+)+$",
            "description": "JSON pointer into avd-target-state/v1; * is every array item"
          },
          "label": {
            "type": "string",
            "maxLength": 60
          },
          "decidableFrom": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/tier"
            },
            "description": "Tiers whose facts alone can justify this decision; avd-current-state's manifest coverage counts the ones that include azure"
          }
        }
      }
    },
    "facts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "tier",
          "contract",
          "path",
          "grain",
          "unit",
          "privacy",
          "status",
          "evidences"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(c11|c12|intake|liquidware)\\.[A-Za-z0-9.]{2,80}$"
          },
          "tier": {
            "$ref": "#/$defs/tier"
          },
          "contract": {
            "enum": [
              "C11",
              "C12",
              "C19",
              null
            ],
            "description": "null while a fact has no contract yet (liquidware)"
          },
          "path": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^(/[A-Za-z0-9*]+)+$",
            "description": "JSON pointer into the contract's document; * is every array item"
          },
          "aggregate": {
            "enum": [
              "count",
              "value",
              "distinct"
            ],
            "description": "count: the number of items at path; distinct: the set of values; value (default): the value itself"
          },
          "grain": {
            "enum": [
              "estate",
              "subscription",
              "hostPool",
              "storageAccount",
              "group",
              "window",
              "host"
            ]
          },
          "unit": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9%/-]{1,20}$"
          },
          "privacy": {
            "enum": [
              "count",
              "public",
              "pseudonym",
              "boolean",
              "measure",
              "group-behavior"
            ]
          },
          "status": {
            "enum": [
              "built",
              "specified",
              "proposed"
            ]
          },
          "evidences": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/decisionId"
            }
          }
        }
      }
    }
  }
}
