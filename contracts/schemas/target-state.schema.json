{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "avd-target-state/v1: a pseudonymous, deployment-ready AVD target-state design",
  "description": "Contract C14. Produced by avd-readiness-stratusphere's factory (stage 5, design); read by avd-landing-zone's ConvertFrom-AvdTargetState.ps1 (lz-cloudnative), proposed to avd-swarm as a plan input, and harvested into the brain as part of an engagement record. Every decision cites facts by their ID in the fact register (C15). Approval is a separate avd-target-approval/v1 file that pins this file's SHA-256 (target-approval.schema.json). No field holds a tenant, subscription, group or object ID, a user, a machine, an address or free text beyond a short note that harvests drop.",
  "type": "object",
  "required": [
    "schema",
    "estate",
    "engagement",
    "generatedUtc",
    "producer",
    "pins",
    "evidence",
    "target",
    "identity",
    "region",
    "network",
    "hostPools",
    "profiles",
    "cost"
  ],
  "additionalProperties": false,
  "$defs": {
    "utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "clock": {
      "type": "string",
      "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
    },
    "region": {
      "type": "string",
      "pattern": "^[a-z0-9]{2,40}$"
    },
    "catalogId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
    },
    "evidenceRef": {
      "type": "string",
      "pattern": "^(c11|c12|intake|liquidware)\\.[A-Za-z0-9.]{2,80}(@(hp|st|sub|persona|tp)-[0-9a-f]{1,8})?$",
      "description": "<factId> or <factId>@<pseudonym>; factId must be in the fact register (C15)"
    },
    "decision": {
      "type": "object",
      "required": [
        "value",
        "evidence",
        "confidence"
      ],
      "additionalProperties": false,
      "properties": {
        "value": {},
        "rule": {
          "type": "string",
          "pattern": "^[a-z0-9-]{2,40}@v[0-9]{1,4}$",
          "description": "A rule in knowledge/rules/ at pins.brainCommit, as <id>@v<version>, when a rule decided the value"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/evidenceRef"
          }
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "boundBy": {
          "enum": [
            "memory",
            "cpu",
            "guidance"
          ]
        },
        "override": {
          "type": "object",
          "required": [
            "reason"
          ],
          "additionalProperties": false,
          "properties": {
            "reason": {
              "enum": [
                "customer-requirement",
                "policy",
                "cost",
                "risk",
                "other"
              ]
            }
          }
        },
        "note": {
          "type": "string",
          "pattern": "^(?!.*//)[A-Za-z0-9 .,:;()/+=%*-]{0,200}$",
          "description": "Dropped by harvests; never a name, an ID or a link"
        }
      }
    },
    "hostPool": {
      "type": "object",
      "required": [
        "id",
        "replaces",
        "type",
        "appGroup",
        "tier",
        "users",
        "peakConcurrent",
        "vmSize",
        "maxSessions",
        "hosts",
        "power",
        "profileQuotaGiB",
        "monthlyEstimate",
        "apps"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^tp-[0-9]{2}$"
        },
        "persona": {
          "type": "string",
          "pattern": "^persona-[0-9]{1,3}$"
        },
        "replaces": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^hp-[0-9a-f]{8}$"
          },
          "description": "C11/C12 host pool pseudonyms this pool replaces; informational, never a target; empty for an estate not yet on AVD"
        },
        "type": {
          "allOf": [
            {
              "$ref": "#/$defs/decision"
            },
            {
              "properties": {
                "value": {
                  "enum": [
                    "Pooled",
                    "Personal"
                  ]
                }
              }
            }
          ]
        },
        "appGroup": {
          "allOf": [
            {
              "$ref": "#/$defs/decision"
            },
            {
              "properties": {
                "value": {
                  "enum": [
                    "Desktop",
                    "RemoteApp"
                  ]
                }
              }
            }
          ]
        },
        "tier": {
          "enum": [
            "light",
            "medium",
            "heavy",
            "power",
            "gpu"
          ]
        },
        "users": {
          "type": "integer",
          "minimum": 5,
          "description": "Context, not deployed"
        },
        "peakConcurrent": {
          "type": "integer",
          "minimum": 0,
          "description": "Context, not deployed"
        },
        "vmSize": {
          "allOf": [
            {
              "$ref": "#/$defs/decision"
            },
            {
              "properties": {
                "value": {
                  "type": "string",
                  "pattern": "^Standard_[A-Za-z0-9_]{1,40}$"
                }
              }
            }
          ]
        },
        "maxSessions": {
          "allOf": [
            {
              "$ref": "#/$defs/decision"
            },
            {
              "properties": {
                "value": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 999
                }
              }
            }
          ]
        },
        "hosts": {
          "allOf": [
            {
              "$ref": "#/$defs/decision"
            },
            {
              "properties": {
                "value": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 500
                }
              }
            }
          ]
        },
        "power": {
          "allOf": [
            {
              "$ref": "#/$defs/decision"
            },
            {
              "properties": {
                "value": {
                  "type": "object",
                  "required": [
                    "startVmOnConnect",
                    "autoShutdownTime"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "startVmOnConnect": {
                      "type": "boolean"
                    },
                    "autoShutdownTime": {
                      "anyOf": [
                        {
                          "$ref": "#/$defs/clock"
                        },
                        {
                          "const": "none"
                        }
                      ]
                    }
                  }
                }
              }
            }
          ]
        },
        "profileQuotaGiB": {
          "allOf": [
            {
              "$ref": "#/$defs/decision"
            },
            {
              "properties": {
                "value": {
                  "type": "integer",
                  "minimum": 100,
                  "maximum": 102400
                }
              }
            }
          ]
        },
        "monthlyEstimate": {
          "type": "number",
          "minimum": 0,
          "description": "This pool's share of cost.monthlyEstimate, from retail meters"
        },
        "scaling": {
          "type": "object",
          "required": [
            "timeZone",
            "rampUp",
            "peak",
            "rampDown"
          ],
          "additionalProperties": false,
          "properties": {
            "timeZone": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z .()+-]{1,63}$"
            },
            "rampUp": {
              "$ref": "#/$defs/clock"
            },
            "peak": {
              "$ref": "#/$defs/clock"
            },
            "rampDown": {
              "$ref": "#/$defs/clock"
            }
          }
        },
        "apps": {
          "type": "object",
          "required": [
            "image",
            "appAttach",
            "unknown"
          ],
          "additionalProperties": false,
          "properties": {
            "image": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/catalogId"
              }
            },
            "appAttach": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/catalogId"
              }
            },
            "remoteApp": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/catalogId"
              }
            },
            "unknown": {
              "type": "integer",
              "minimum": 0,
              "description": "Apps not in the catalog: a count, never names"
            }
          }
        }
      }
    }
  },
  "properties": {
    "schema": {
      "const": "avd-target-state/v1"
    },
    "estate": {
      "type": "string",
      "pattern": "^est-[0-9a-f]{8}$",
      "description": "The estate's C11 pseudonym"
    },
    "engagement": {
      "type": "string",
      "pattern": "^eng-[0-9]{4}-[0-9]{2}-[0-9a-f]{4}$"
    },
    "generatedUtc": {
      "$ref": "#/$defs/utc"
    },
    "producer": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "const": "avdmf"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      }
    },
    "pins": {
      "type": "object",
      "required": [
        "brainCommit",
        "factRegister"
      ],
      "additionalProperties": false,
      "properties": {
        "brainCommit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "factRegister": {
          "type": "integer",
          "minimum": 1,
          "description": "The register's version the evidence IDs come from"
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": [
        "currentState",
        "forensicWindowEnd",
        "quality"
      ],
      "additionalProperties": false,
      "description": "Freshness of the evidence, for avd-swarm's gate (C11: 7 days, C12: 90 days)",
      "properties": {
        "currentState": {
          "anyOf": [
            {
              "$ref": "#/$defs/utc"
            },
            {
              "type": "null"
            }
          ],
          "description": "generatedUtc of the C11 snapshot used"
        },
        "forensicWindowEnd": {
          "anyOf": [
            {
              "$ref": "#/$defs/date"
            },
            {
              "type": "null"
            }
          ],
          "description": "window.end of the C12 facts used"
        },
        "quality": {
          "enum": [
            "pass",
            "low-confidence",
            "fail",
            null
          ],
          "description": "The factory quality gate's verdict for the C12 window"
        }
      }
    },
    "target": {
      "type": "object",
      "required": [
        "renderer",
        "gaps"
      ],
      "additionalProperties": false,
      "properties": {
        "renderer": {
          "enum": [
            "lz-cloudnative",
            "avd-lza",
            "terraform",
            "report-only"
          ]
        },
        "rendererCommit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$",
          "description": "Commit of the target's capabilities file the factory checked against"
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][A-Za-z0-9./-]{1,80}$"
          },
          "description": "Requirements the renderer can't express; a reader refuses a manifest with gaps"
        }
      }
    },
    "identity": {
      "allOf": [
        {
          "$ref": "#/$defs/decision"
        },
        {
          "properties": {
            "value": {
              "enum": [
                "EntraOnly",
                "HybridADDS",
                "EntraDS"
              ]
            }
          }
        }
      ]
    },
    "region": {
      "allOf": [
        {
          "$ref": "#/$defs/decision"
        },
        {
          "properties": {
            "value": {
              "$ref": "#/$defs/region"
            }
          }
        }
      ]
    },
    "network": {
      "allOf": [
        {
          "$ref": "#/$defs/decision"
        },
        {
          "properties": {
            "value": {
              "enum": [
                "Standalone",
                "HubPeered"
              ]
            }
          }
        }
      ]
    },
    "hostPools": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "$ref": "#/$defs/hostPool"
      }
    },
    "profiles": {
      "type": "object",
      "required": [
        "type",
        "storage"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "FSLogix"
        },
        "storage": {
          "enum": [
            "AzureFilesPremium",
            "AzureFilesStandard",
            "AzureNetAppFiles"
          ]
        }
      }
    },
    "liquidware": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional avd-liquidware tier (ProfileUnity, FlexApp), read by avd-liquidware when that tier is built; proposed",
      "properties": {
        "profileUnity": {
          "type": "boolean"
        },
        "flexApp": {
          "type": "boolean"
        }
      }
    },
    "cost": {
      "type": "object",
      "required": [
        "monthlyEstimate",
        "currency",
        "unmatchedLines"
      ],
      "additionalProperties": false,
      "properties": {
        "monthlyEstimate": {
          "type": "number",
          "minimum": 0,
          "description": "Total over every host pool"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "unmatchedLines": {
          "type": "integer",
          "minimum": 0,
          "description": "Cost lines that matched no single retail meter (never guessed)"
        }
      }
    }
  }
}
